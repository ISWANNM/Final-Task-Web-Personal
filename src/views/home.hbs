<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <!-- container Section -->
<div class="container mx-auto px-6 py-12 md:py-24">
  <!-- Hero Section -->
  <section id="hero">
    <div class="hero-content flex-col lg:flex-row justify-between items-center gap-8 lg:p-16 mb-32"  style=" margin-bottom: 128px">
      <!-- Left - Profile Image -->
      <div class="hero-image relatif w-full lg:w-1/3 flex justify-center lg:justify-start">
        <div class="image-wrapper">
          <div class="image-glow"></div>
          <img src="/img/iswan.jpg" alt="Profile" class="profile-img" />
        </div>
      </div>
  
      <!-- Right - Text -->
      <div class="hero-text">
        <h1>Hi, I'm Iswan 👋</h1>
        <p class="subtitle">Indie Hacker & Full-Stack Developer</p>
        <p class="description">
          I build and ship digital products from scratch to production. Passionate about creating end-to-end
          solutions and turning ideas into fully functional applications. With expertise in both frontend and backend
          development, I handle everything from initial concept to deployment and maintenance.
        </p>
  
        <div class="info">
          <div><span>📍</span> Garut, Jawa Barat, Indonesia</div>
          <div><span class="dot"></span> Available for new projects</div>
        </div>
  
        <div class="buttons">
          <a href="https://wa.me/6281234567" target="_blank" class="btn btn-green">
            <img src="/img/whatsapp.png" alt="WhatsApp" class="icon" />
            Let's Talk
          </a>
          <a href="https://drive.google.com/file/d/1lftBDoFQZXvT_B8yl6brmnDip8vXWlj2/view?usp=sharing" target="_blank"
            class="btn btn-black">
            Lihat CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section id="tech-stack" class="tech-stack-section">
    <div class="container">
      <h2 class="text-2xl md:text-3xl font-bold mb-12">
        Tech Stack - Tools I Use Everyday
      </h2>

      <!-- Swiper Container -->
      <div class="relative">
        <!-- Gradient Overlay Left -->
        <div
          class="absolute left-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-r from-white dark:from-gray-900 to-transparent pointer-events-none">
        </div>
        <!-- Gradient Overlay Right -->
        <div
          class="absolute right-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-l from-white dark:from-gray-900 to-transparent pointer-events-none">
        </div>
        <div class="swiper tech-swiper">
          <div class="swiper-wrapper py-4">
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/nodejs.png" alt="Node.js" />
                </div>
                <span>Node.js</span>
              </div>
            </div>
            <!-- Express.js -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/express.jfif" alt="Express.js" />
                </div>
                <span>Express.js</span>
              </div>
            </div>
            <!-- TypeScript -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/typescript.png" alt="TypeScript" />
                </div>
                <span>TypeScript</span>
              </div>
            </div>
            <!-- JavaScript -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/js.png" alt="JavaScript" />
                </div>
                <span>JavaScript</span>
              </div>
            </div>
            <!-- PostgreSQL -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/postgresql.png" alt="PostgreSQL" />
                </div>
                <span>PostgreSQL</span>
              </div>
            </div>
            <!-- MongoDB -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/mongodb.png" alt="MongoDB" />
                </div>
                <span>MongoDB</span>
              </div>
            </div>
            <!-- .NET -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/dotnet.png" alt=".NET" />
                </div>
                <span>.NET</span>
              </div>
            </div>
            <!-- Unity -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/unity.png" alt="Unity" />
                </div>
                <span>Unity</span>
              </div>
            </div>
            <!-- React -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/react.png" alt="React" />
                </div>
                <span>React</span>
              </div>
            </div>
            <!-- Next.js -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/next.png" alt="Next.js" />
                </div>
                <span>Next.js</span>
              </div>
            </div>
            <!-- Tailwind -->
            <div class="swiper-slide">
              <div class="tech-item">
                <div class="tech-icon">
                  <img src="/img/skills/tailwind.png" alt="Tailwind" />
                </div>
                <span>Tailwind</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const swiper = new Swiper('.tech-swiper', {
            slidesPerView: 'auto',
            spaceBetween: 30,
            loop: true,
            allowTouchMove: true,
            speed: 5000,
            autoplay: {
              delay: 0,
              disableOnInteraction: false,
              pauseOnMouseEnter: true,
              reverseDirection: true
            },
            breakpoints: {
              320: {
                spaceBetween: 20
              },
              480: {
                spaceBetween: 30
              },
              640: {
                spaceBetween: 40
              }
            },
            on: {
              beforeInit: function () {
                // Duplicate slides for smoother infinite loop
                const slides = this.el.querySelectorAll('.swiper-slide');
                slides.forEach(slide => {
                  this.el.querySelector('.swiper-wrapper').appendChild(slide.cloneNode(true));
                });
              }
            }
          });

          // Force start autoplay
          swiper.autoplay.start();
        });
      </script>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience" class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold mb-6 text-gray-800">Work Experience</h2>
  
      {{#if isLoggedIn}}
      <div class="mb-6">
        <a href="/admin/add_work_experience"
          class="inline-block bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">
          + Add Experience
        </a>
      </div>
      {{/if}}
  
      <div class="space-y-8">
        {{#each experiences}}
        <div
          class="flex flex-col md:flex-row items-start bg-white dark:bg-gray-800 p-6 md:p-8 rounded-xl shadow-sm hover:shadow-md transition">
          <img src="{{image_url}}" alt="{{company}}" class="w-16 h-16 rounded-lg mb-4 md:mb-0 object-contain bg-white" />
      
          <div class="md:ml-8 flex-grow">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4">
              <div>
                <h3 class="font-semibold text-lg">{{position}}</h3>
                <p class="text-green-600 dark:text-green-400 text-sm">{{company}}</p>
              </div>
              <span class="text-sm text-gray-500 dark:text-gray-400 mt-2 md:mt-0">
                {{start_date}} - {{#if end_date}}{{end_date}}{{else}}Present{{/if}}
              </span>
            </div>
      
            <ul class="text-gray-600 dark:text-gray-400 text-sm space-y-2 list-disc list-inside mb-4">
              {{#each description}}
              <li>{{this}}</li>
              {{/each}}
            </ul>
            <div class="flex flex-wrap gap-2">
              {{#each tech_used}}
              <span
                class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-full text-xs font-medium text-gray-600 dark:text-gray-400">{{this}}</span>
              {{/each}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-800">Projects</h2>
        {{#if isLoggedIn}}
        <div class="mb-6">
          <a href="/admin/add-project"
            class="inline-block bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">
            + Add Project
          </a>
        </div>
        {{/if}}
        <p class="text-gray-600 text-sm md:text-base max-w-2xl">
          Here are some of my featured projects that highlight my experience in full stack development.
        </p>
      </div>
  
      <!-- Loop Project Cards -->
      <div class="grid md:grid-cols-2 gap-10">
        {{#each projects}}
        <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <div class="h-52 bg-gray-100 flex items-center justify-center">
            <img src="{{image_url}}" alt="{{name}}" class="w-full h-full object-contain" />
          </div>
  
          <div class="p-6">
            <h3 class="font-semibold text-xl mb-3 text-gray-800">{{title}}</h3>
            <p class="text-gray-600 text-sm mb-4">{{description}}</p>
            <!-- Tech Stack -->
            <div class="flex flex-wrap gap-2">
              {{#each tech_stack}}
              <span
                class="px-3 py-1 bg-gray-100 dark:bg-gray-700 rounded-full text-xs font-medium text-gray-600 dark:text-gray-400">{{this}}</span>
              {{/each}}
            </div>
            <!-- Link Section -->
            <div class="flex gap-3 text-sm">
              <span class="inline-flex items-center px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400">
                <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.237 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                Private Repository
              </span>
  
              {{#if project_link}}
              <a href="{{project_link}}" target="_blank"
                class="inline-flex items-center px-3 py-1.5 text-xs text-blue-600 hover:text-blue-800 transition-colors">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Live Demo
              </a>
              {{else}}
              <span class="inline-flex items-center px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Demo Unavailable
              </span>
              {{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
