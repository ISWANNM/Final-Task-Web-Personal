          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-sm md:text-base">iswannurul.m@gmail.com</span>
        </a>
  
        <!-- Separator -->
        <span class="hidden md:inline text-gray-300">|</span>
  
        <!-- WhatsApp -->
        <a href="https://wa.me/62812345678910" target="_blank"
          class="flex items-center space-x-2 text-gray-600 hover:text-gray-900 transition-colors">
          <img src="/img/whatsapp.png" alt="WhatsApp" class="w-5 h-5">
          <span class="text-sm md:text-base">+62 123-4567-8910</span>
